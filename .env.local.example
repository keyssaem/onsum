# ------------------------------------------------------------------
# 이 파일을 복사해서 `.env.local` 이라는 이름으로 저장한 뒤 값을 채우세요.
#   PowerShell:  Copy-Item .env.local.example .env.local
# .env.local 은 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.
# ------------------------------------------------------------------

# [필수] Supabase 프로젝트 URL
# Supabase 대시보드 → 좌측 하단 톱니바퀴(Project Settings) → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# [필수] Supabase 공개 키 (anon / publishable key)
# 같은 화면의 Project API keys → anon public
# ⚠️ 이 키는 브라우저에 노출되는 것이 정상입니다. 대신 RLS(행 수준 보안)로 보호합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ service_role 키는 절대 이 파일에 넣지 마세요.
#    브라우저로 나가는 순간 DB 전체가 열립니다. 서버에서만 쓰는 키입니다.

# [배포용] GitHub Pages 프로젝트 저장소에 배포할 때만 사용합니다.
#   https://아이디.github.io/저장소명  → NEXT_PUBLIC_BASE_PATH=/저장소명
#   https://아이디.github.io          → 빈 값
#   커스텀 도메인                      → 빈 값
# 로컬 개발 중에는 비워두세요. (GitHub Actions가 배포 시 자동 주입)
NEXT_PUBLIC_BASE_PATH=
